   "beats": [
    {
     "say_hi": "चंदा रानी रात में आया",
     "say": "Chanda rani raat mein aaya",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "प्यारी रोशनी से हमको भाया",
     "say": "Pyari roshni se hamko bhaya",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "तारे सारे भी साथ चले",
     "say": "Tare sare bhi saath chale",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "सितारों से हमको भाया",
     "say": "Sitaron se hamko bhaya",
     "speaker": "singer",
     "emotion": "happy"
    }
   ]
  },
  {
   "kind": "chorus",
   "place": "night",
   "cast": [
    "moon",
    "star"
   ],
   "beats": [
    {
     "say_hi": "आओ बच्चो, चलो हम गाएँ",
     "say": "Aao bachcho, chalo hume gaen",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "चंदा और तारे हमको बुलाएँ",
     "say": "Chanda aur tare hamko bulaen",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "रात की शांति में खेलें प्यारे",
     "say": "Raat ki shanti mein khelen pyare",
     "speaker": "singer",
     "emotion": "happy"
    },
    {
     "say_hi": "झूले नाचे, बनो सब न्यारे",
     "say": "Jhule nache, bano sab nyare",
     "speaker": "singer",
     "emotion": "happy"
    }
   ]
