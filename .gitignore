# Login files: anyone with these could upload to the channel. Never commit them.
client_secret*.json
youtube_token.json
youtube_token_*.json

# The owner's voice sample
voices/*.wav
voices/serial/
series/*/voices/

# Contains SearXNG's secret key
searxng/settings.yml

# Python environments and caches (rebuild them, don't store them)
venv/
venv-voice/
venv-video/
wan2gp/
.venv/
__pycache__/
*.pyc

# Generated and heavy files (scripts, notes and YouTube details stay in git)
projects/*/audio/
projects/*/output/
projects/*/images/
projects/*/fonts
projects/*/music.*
series/*/episodes/*/audio/
series/*/episodes/*/output/
series/*/music/
audio/
output/
music.mp3
music.wav
music.m4a

# Editor and system files
.vscode/
.idea/
.DS_Store

# rhymes: generated media (lyrics.txt, script.json and review.md are kept)
rhymes/songs/*/audio/
rhymes/songs/*/output/
rhymes/songs/*/youtube/*.jpg
rhymes/voices/
rhymes/cast.png
rhymes/songs/*/images/
rhymes/cast_art/*_cut.png

# ACE-Step 1.5 code + 6 GB of models (git clone, see rhyme/README.md)
ace-step/
.cache/
